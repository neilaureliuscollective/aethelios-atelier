{
  "name": "aethelios-atelier",
  "version": "0.1.0",
  "private": true,
  "description": "Aethelios Atelier — founder-led digital infrastructure studio. Standalone application.",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "dev:cofounder": "ATELIER_DIST_DIR=.next-cofounder ATELIER_DATA_DIR=.data-cofounder next dev --port 3010",
    "build": "next build",
    "build:cofounder": "ATELIER_DIST_DIR=.next-cofounder next build",
    "start": "next start --port 3000",
    "start:cofounder": "ATELIER_DIST_DIR=.next-cofounder next start --port 3010",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:auth": "node scripts/auth-acceptance.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "next": "^15.5.4",
    "next-auth": "5.0.0-beta.32",
    "openai": "^4.104.0",
    "pngjs": "^7.0.0",
    "postgres": "^3.4.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^22.18.8",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.4",
    "puppeteer-core": "^25.14.0",
    "typescript": "^5.9.2",
    "vitest": "^2.1.9"
  }
}
