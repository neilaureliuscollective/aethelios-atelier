# Aethelios Atelier — local configuration
# Unconfigured features fail closed. Do not point this at Aethelios production.

# Persistence adapter: sqlite_local | memory | postgres | unconfigured
# Local default: sqlite_local. Vercel / hosted platforms refuse sqlite_local and memory.
ATELIER_PERSISTENCE_ADAPTER=sqlite_local
ATELIER_DATA_DIR=.data

# Hosted / Vercel: dedicated Atelier Postgres (Neon or Vercel Postgres).
# Never reuse the Aethelios production database.
# ATELIER_PERSISTENCE_ADAPTER=postgres
# DATABASE_URL=postgres://USER:PASSWORD@HOST/atelier?sslmode=require
# POSTGRES_URL is also accepted (Vercel Storage / Neon marketplace).
# ATELIER_DATABASE_URL overrides POSTGRES_URL and DATABASE_URL when set.

# Auth adapter: simulated (labeled local identities) | unconfigured
ATELIER_AUTH_ADAPTER=simulated
# Isolated-local simulator gate. Required for simulated auth on local machines.
# Recognized hosted platforms (Vercel, Fly, Render, etc.) always refuse simulated
# auth, even if ATELIER_ISOLATED_LOCAL=true was accidentally copied.
ATELIER_ALLOW_SIMULATED_AUTH=true
ATELIER_ISOLATED_LOCAL=true
# Production-mode simulated auth also requires an exact loopback origin hostname
# (localhost, 127.0.0.1, or ::1). localhost.example.com does not qualify.
# ATELIER_PUBLIC_ORIGIN=http://127.0.0.1:3000
# ATELIER_HOSTED=true forces hosted refusal even on a local machine.

# Required in any non-development environment that issues sessions.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ATELIER_SESSION_SECRET=

# Simulated founder identity (email must match a seeded founder user)
ATELIER_FOUNDER_EMAILS=neil.local@atelier.invalid

# OpenAI — never enable live calls without separate approval.
# Even if OPENAI_API_KEY is present, live calls stay off unless ATELIER_OPENAI_ENABLED=true.
ATELIER_OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ATELIER_OPENAI_TIMEOUT_MS=25000
ATELIER_OPENAI_MAX_OUTPUT_TOKENS=900
ATELIER_OPENAI_DAILY_LIMIT_PER_PROJECT=24
# Companion workspace budgets (server-enforced). Empty values keep the plan defaults.
ATELIER_DEFAULT_PLAN=atelier
# ATELIER_PLAN_TALK_LIMIT=80
# ATELIER_PLAN_IMAGE_LIMIT=20
# ATELIER_PLAN_VOICE_MINUTES=30
# ATELIER_MAX_CONCURRENT_GENERATIONS=1
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_VOICE_MODEL=gpt-realtime

# Isolated cofounder worktree/dev: ATELIER_DIST_DIR=.next-cofounder ATELIER_DATA_DIR=.data-cofounder
# pnpm dev:cofounder serves this feature on port 3010.

# Billing remains an isolated future boundary. Do not set Stripe keys here.
ATELIER_BILLING_ENABLED=false
