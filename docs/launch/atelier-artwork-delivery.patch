+import { describe, expect, it } from "vitest";
+import {
+  exportDownloadFailedMessage,
+  exportSaveFailedMessage,
+  exportSavedStatus,
+  fetchSavedExportBytes,
+  type SavedExportRef
+} from "@/lib/cofounder/exportDelivery";
+
+const ref: SavedExportRef = {
+  assetId: "asset_1",
+  assetUrl: "/api/companion/assets/asset_1?businessId=biz",
+  revisionId: "crev_1",
+  draftId: "studio_1",
+  width: 1600,
+  height: 1200,
+  outputHash: "abc"
+};
+
+describe("export delivery stages", () => {
+  it("keeps a successful save distinct from a failed download", async () => {
+    await expect(
+      fetchSavedExportBytes(ref, async () => new Response(null, { status: 503 }))
+    ).rejects.toThrow(exportDownloadFailedMessage());
+    await expect(
+      fetchSavedExportBytes(ref, async () => {
+        throw new TypeError("network");
+      })
+    ).rejects.toThrow(exportDownloadFailedMessage());
+    expect(exportSavedStatus(ref)).toContain("Export saved 1600×1200");
+    expect(exportSavedStatus(ref)).toContain("does not confirm that the device kept a copy");
+  });
+
+  it("does not claim the draft is unmarked when save already succeeded", () => {
+    expect(exportDownloadFailedMessage()).not.toMatch(/not marked exported/i);
+    expect(exportSaveFailedMessage(new Error("The composed image was rejected."), "fallback")).toBe(
+      "The composed image was rejected."
+    );
+  });
+
+  it("rejects a missing or empty download without inventing bytes", async () => {
+    await expect(
+      fetchSavedExportBytes({ ...ref, assetUrl: "" }, async () => new Response(new Uint8Array([1, 2, 3])))
+    ).rejects.toThrow(/no download URL/);
+    await expect(fetchSavedExportBytes(ref, async () => new Response(new Uint8Array()))).rejects.toThrow(
+      exportDownloadFailedMessage()
+    );
+  });
+});
diff --git a/src/lib/cofounder/exportDelivery.ts b/src/lib/cofounder/exportDelivery.ts
new file mode 100644
index 0000000..5872829
--- /dev/null
+++ b/src/lib/cofounder/exportDelivery.ts
@@ -0,0 +1,62 @@
+export type ExportDeliveryStage =
+  | "idle"
+  | "rendering"
+  | "saving"
+  | "saved"
+  | "downloading"
+  | "download_failed";
+
+export type SavedExportRef = {
+  assetId: string;
+  assetUrl: string;
+  revisionId: string;
+  draftId: string;
+  width: number;
+  height: number;
+  outputHash?: string;
+};
+
+export function exportSaveFailedMessage(error: unknown, fallback: string) {
+  return error instanceof Error && error.message.trim() ? error.message : fallback;
+}
+
+export function exportDownloadFailedMessage() {
+  return "The export is saved. Download failed. Use Download again — a new export was not created.";
+}
+
+export function exportSavedStatus(ref: SavedExportRef) {
+  return `Export saved ${ref.width}×${ref.height}. Your browser was asked to download the file. The file is stored with this account; this message does not confirm that the device kept a copy.`;
+}
+
+export async function fetchSavedExportBytes(
+  ref: SavedExportRef,
+  fetchImpl: typeof fetch = fetch
+): Promise<Blob> {
+  if (!ref.assetUrl) {
+    throw new Error("The saved export has no download URL. The artifact remains on the server if saving succeeded.");
+  }
+  let response: Response;
+  try {
+    response = await fetchImpl(ref.assetUrl, { credentials: "same-origin" });
+  } catch {
+    throw new Error(exportDownloadFailedMessage());
+  }
+  if (!response.ok) {
+    throw new Error(exportDownloadFailedMessage());
+  }
+  const blob = await response.blob();
+  if (!blob.size) {
+    throw new Error(exportDownloadFailedMessage());
+  }
+  return blob;
+}
+
+export function triggerBrowserDownload(blob: Blob, filename: string) {
+  const objectUrl = URL.createObjectURL(blob);
+  const link = document.createElement("a");
+  link.href = objectUrl;
+  link.download = filename;
+  link.rel = "noopener";
+  link.click();
+  URL.revokeObjectURL(objectUrl);
+}
