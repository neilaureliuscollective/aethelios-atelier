+async function goto(p){await page.goto(BASE+p,{waitUntil:'networkidle0'})}async function click(label){await page.waitForFunction(label=>[...document.querySelectorAll('button')].some(n=>n.textContent?.trim()===label&&!n.disabled),{},label);await page.evaluate(label=>[...document.querySelectorAll('button')].find(n=>n.textContent?.trim()===label).click(),label)}
+const stamp=new Date().toISOString();const selection={selectionId:'review-meridian',localRevision:1,catalogVersion:1,templateVersion:1,businessName:'Meridian Sitting Room',businessType:'appointment',audience:'Neighbors seeking a thoughtful gathering space',desiredQualities:['refined','welcoming'],intent:'clearer_presence',intentNote:'Announce our opening',customerFeeling:'calm',selectedDirectionId:'lumen',visualPreferences:{paletteId:'ivory_hall',visualDirectionId:'glass',headline:'A place to gather'},serviceInterest:'website',likesNote:'Keep the exact lettering',changeNote:'',visitorNotes:'',exclusions:'No invented testimonials',createdAt:stamp,updatedAt:stamp};
+const drafts=[];try{await goto('/account');await page.evaluate(async()=>fetch('/api/session/sign-in',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({email:'owner.local@atelier.invalid'})}));
+for(const [direction,palette,visual] of [['lumen','ivory_hall','glass'],['hearth','hearth_linen','material'],['signal','signal_ink','mark']]){selection.selectedDirectionId=direction;selection.visualPreferences.paletteId=palette;selection.visualPreferences.visualDirectionId=visual;selection.localRevision++;
+await page.evaluate(selection=>sessionStorage.setItem('aethelios.atelier.discovery.handoff.v1',JSON.stringify({kind:'discovery_handoff',selection})),selection);await goto('/companion/studio');await click('Review Discovery direction for this business');await page.select('aside[aria-label="Brand direction"] select','new_brand');const adopted=page.waitForResponse(r=>r.url().includes('/api/companion/brand-direction')&&r.request().method()==='POST');await click('Lock and save this direction');const adoption=await adopted;check(direction+' reviewed adoption succeeds',adoption.ok());await page.waitForFunction(()=>document.body.innerText.includes('Saved direction:'));
+const created=await page.evaluate(async()=>{const w=await fetch('/api/companion/workspace').then(r=>r.json());return fetch('/api/companion/studio',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({businessId:w.business.id,headline:'A place to gather',body:'Meridian Sitting Room opens this autumn.',direction:'Retain exact text. Curated local direction.'})}).then(r=>r.json())});if(!created.draft)throw new Error(JSON.stringify(created));drafts.push(created.draft);await goto('/companion/studio?draftId='+created.draft.id);await page.waitForSelector('[data-studio-preview="canvas"]');await page.waitForFunction(()=>document.querySelector('[data-studio-preview="canvas"]')?.dataset.renderState==='ready');await new Promise(r=>setTimeout(r,500));const raster=await page.$eval('[data-studio-preview="canvas"]',n=>n.toDataURL());fs.writeFileSync(path.join(OUT,'direction-'+direction+'.png'),Buffer.from(raster.split(',')[1],'base64'));await page.screenshot({path:path.join(OUT,'direction-'+direction+'-studio-1440.png'),fullPage:true});check(direction+' draft retains versioned kit and design spec',created.draft.brandKit?.designSpec.directionId===direction&&created.draft.brandKit?.mode==='new_brand',created.draft.brandKit?.revision);}
